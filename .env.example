# Copy to .env and adjust. Never commit .env.

# --- server ---
NODE_ENV=development
PORT=4000
# Path of the SQLite file (relative to the server workspace)
DATABASE_PATH=./data/dms.sqlite
# Secret for signing JWTs (>= 16 chars). Generate your own.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
# Origin allowed by CORS (the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Business time zone (IANA). "Today" for report periods and effective dates is the date in this zone.
APP_TIMEZONE=Asia/Colombo
# Notification retry (UC-DA-001 extension 12a / UC-DIST-02 12a)
NOTIFICATION_RETRY_INTERVAL_MS=60000
NOTIFICATION_MAX_RETRIES=5
# Dev-only password given to every seeded user by `npm run db:seed`
SEED_DEFAULT_PASSWORD=ChangeMe-Dev-2026

# --- client (Vite) ---
# Base URL of the API (empty = same origin via the Vite proxy)
VITE_API_BASE_URL=
# Password shown to the sign-in screen's demo accounts (must equal SEED_DEFAULT_PASSWORD on the server)
VITE_DEMO_PASSWORD=ChangeMe-Dev-2026
