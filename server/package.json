{
  "name": "@dms/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../.env src/server.ts",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate-cli.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/seeds/seed-cli.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dms/shared": "*",
    "better-sqlite3": "^13.0.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.0.0",
    "vitest": "^5.0.0"
  }
}
